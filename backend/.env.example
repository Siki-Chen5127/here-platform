# Runtime
HERE_ENVIRONMENT=development
HERE_API_HOST=127.0.0.1
HERE_API_PORT=8000
HERE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local SQLite fallback. For SQL Server, use the URL below instead.
HERE_DATABASE_URL=sqlite:///./here-dev.db
# HERE_DATABASE_URL=mssql+pyodbc://@localhost/HerePlatform?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes&Encrypt=no
HERE_SQLSERVER_HOST=localhost
HERE_SQLSERVER_DATABASE=HerePlatform
HERE_SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server

# Replace before any shared or production deployment.
HERE_JWT_SECRET=replace-with-at-least-32-random-characters
HERE_ACCESS_TOKEN_MINUTES=60
HERE_AUTO_CREATE_SCHEMA=true

# Development bootstrap account. Disable after the first administrator is created.
HERE_BOOTSTRAP_ADMIN=true
HERE_BOOTSTRAP_ADMIN_EMAIL=admin@here.edu
HERE_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
HERE_BOOTSTRAP_ADMIN_NAME=系统管理员
